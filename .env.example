# Copy to .env and fill in. NEVER commit .env.
# Keys are read as <EXCHANGE>_API_KEY / <EXCHANGE>_API_SECRET, using the `exchange` from config.toml.

# Bitvavo API key: enable "View" and "Trade" ONLY. Do NOT enable "Withdraw".
# Whitelist your server's IP address on the key.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Only if exchange = "binance": Reading + Spot Trading only, no withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Binance Spot Testnet keys (https://testnet.binance.vision) for mode = "testnet"
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional Telegram alerts: create a bot via @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
